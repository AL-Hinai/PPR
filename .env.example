# Copy to .env and adjust. Never commit the real .env.
SECRET_KEY=change-me-to-a-long-random-string

# --- Production (PythonAnywhere) ---
# ALLOWED_HOSTS=yourusername.pythonanywhere.com
# CSRF_TRUSTED_ORIGINS=https://yourusername.pythonanywhere.com
# DB_NAME=yourusername$ppr
# DB_USER=yourusername
# DB_PASSWORD=your-mysql-password
# DB_HOST=yourusername.mysql.pythonanywhere-services.com
# DB_PORT=3306

# Email (optional; local default prints emails to the console)
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=PPR <no-reply@example.com>
# Public address, for links in notification emails
# SITE_URL=https://yourusername.pythonanywhere.com

# eCTD validation (optional overrides)
# ECTD_REGION=gcc
# ECTD_COUNTRY=om
# sync: validate during the request (local default). queue: background worker (production default),
# run `manage.py run_validation_worker` as a PythonAnywhere always-on task.
# VALIDATION_MODE=queue
# ECTD_MAX_UPLOAD_MB=500
# ECTD_DTD_PATH=/home/yourusername/ppr/apps/validation/dtd/ich-ectd-3-2.dtd

# One-click sign-in buttons for the seed_demo accounts on the login page (proof of concept).
# On by default in local development; never switch it on for a public deployment.
# DEMO_LOGIN=False
# DEMO_PASSWORD=Demo@2026

# Dossier assistant (any OpenAI-compatible chat API; DeepSeek by default).
# Without a key the assistant runs in offline mode: it shows matching passages, no written answer.
# On a free PythonAnywhere account outbound HTTPS is limited to an allow-list; check the API host is on it.
# ASSISTANT_API_KEY=
# ASSISTANT_BASE_URL=https://api.deepseek.com/v1
# ASSISTANT_MODEL=deepseek-v4-pro

# Assign review teams automatically from reviewer specialties (False: HOD assigns by hand)
AUTO_ASSIGN_REVIEW_TEAMS=True
